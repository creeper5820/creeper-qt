Language: Cpp

BasedOnStyle: WebKit

# 使用空格而不是 Tab
UseTab: Never

# 缩进 4 字符
IndentWidth: 4
TabWidth: 4

# 访问修饰符（public）等靠左对齐
AccessModifierOffset: -4
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0

# 大括号的换行规则
BreakBeforeBraces: Attach

# 模板定义的换行规则
BreakTemplateDeclarations: Yes

# 最大列宽度
ColumnLimit: 100

# 是否允许短的函数，语句块等单独一行
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortBlocksOnASingleLine: Empty
AllowShortFunctionsOnASingleLine: All

BreakBeforeBinaryOperators: NonAssignment
PenaltyBreakAssignment: 2
PenaltyBreakString: 2
AlignConsecutiveAssignments:
  Enabled: true

# 头文件排序与分组
SortIncludes: true
IncludeBlocks: Regroup
IncludeCategories:
  # 项目头（含 .impl.hh）
  - Regex: '^"(creeper-qt/|.*\.impl\.hh")'
    Priority: 1
  - Regex: '^<(creeper-qt/)'
    Priority: 1
  # Qt
  - Regex: '^<Q'
    Priority: 2
  # 标准库
  - Regex: '^<[a-z_]+>'
    Priority: 3
  - Regex: '.*'
    Priority: 4
